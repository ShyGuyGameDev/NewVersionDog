[Unit]
Description=camera (raw MJPEG; YOLO runs on Mac)
Requires=network-online.target
After=network.target sysinit.target network-online.target

# Raw only on this Pi — no ultralytics/torch required.
# Mac: YOLOv8 Working/dog_yolo_mac.py pulls http://<pi>:8000/frame.jpg
# Restart: sudo systemctl restart camera

[Service]
ExecStart=/usr/bin/python3 /home/pi/system/cam.py
WorkingDirectory=/home/pi/system
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=3
User=pi

[Install]
WantedBy=multi-user.target

